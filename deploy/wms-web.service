[Unit]
Description=WMS-Web backend (Spring Boot)
After=network.target docker.service
Requires=docker.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/app

# DB 접속 정보는 이 파일에서 읽는다. 서버에서 직접 만들고 chmod 600.
EnvironmentFile=/etc/wms-web.env

# 서버 RAM이 1GB뿐이라 힙을 제한한다. 안 걸면 JVM이 넉넉히 잡아 스왑을 심하게 쓴다.
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /home/ubuntu/app/wms-web.jar

SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
